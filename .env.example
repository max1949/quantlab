# ============================================================
# QuantLab AI 环境变量样例
# 用法: 复制为 .env 并按需修改 (cp .env.example .env)
# .env 不会被提交 (见 .gitignore)
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=quantlab
POSTGRES_DB=quantlab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 后端使用的完整连接串 (容器内用服务名 postgres, 本机直连用 localhost)
DATABASE_URL=postgresql+psycopg://quantlab:quantlab@postgres:5432/quantlab

# ---- Redis (缓存 / Celery broker & backend) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- 后端服务 ----
BACKEND_PORT=8000
APP_ENV=development
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 行情数据 (V1: PostgreSQL 存索引 + Parquet 存 K 线) ----
MARKET_DATA_DIR=/app/data/market_data

# ---- AI 研究助手 (Sprint 7: 外部 LLM, OpenAI 兼容; 留空则降级为本地规则分析) ----
AI_ENABLED=true
# 兼容 DeepSeek / OpenAI / Moonshot 等; 默认 DeepSeek。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=          # 填入后即启用 LLM; 不填则用 engine 本地规则分析 (无网络也可用)
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.4
